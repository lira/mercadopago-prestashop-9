{
  "name": "mercadopago/prestashop-v2",
  "description": "MercadoPago payment module for PrestaShop - Version 5.0.2",
  "license": "OSL-3.0",
  "type": "prestashop-module",
  "keywords": [
    "prestashop",
    "payment",
    "mercadopago",
    "ecommerce"
  ],
  "authors": [
    {
      "name": "MercadoPago",
      "email": "developers@mercadopago.com",
      "homepage": "https://www.mercadopago.com"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "doctrine/dbal": "^3.6",
    "doctrine/migrations": "^3.6",
    "symfony/http-client": "^6.0",
    "mp-plugins/php-sdk": "2.13.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-doctrine": "^1.3",
    "phpstan/phpstan-symfony": "^1.3",
    "phpunit/php-code-coverage": "^10.1",
    "phpunit/phpunit": "^10.5",
    "prestashop/php-dev-tools": "^5",
    "squizlabs/php_codesniffer": "^3.13",
    "symfony/phpunit-bridge": "^6.0"
  },
  "scripts": {
    "lint": [
      "Composer\\Config::disableProcessTimeout",
      "phpcs --extensions=php --warning-severity=0 --standard=phpcs.xml ."
    ],
    "lint:fix": [
      "Composer\\Config::disableProcessTimeout",
      "phpcbf --extensions=php --standard=phpcs.xml ."
    ],
    "cs": [
      "Composer\\Config::disableProcessTimeout",
      "php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-unsupported-php-version=yes --verbose"
    ],
    "cs:check": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/validate-marketplace-standards.sh"
    ],
    "stan": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/validate-marketplace-compatibility.sh"
    ],
    "quality": [
      "@lint",
      "@cs:check"
    ],
    "quality:fix": [
      "@lint:fix",
      "@cs"
    ],
    "fix-all": [
      "Composer\\Config::disableProcessTimeout",
      "@lint:fix",
      "@cs",
      "echo '✅ Todas as correções automáticas foram aplicadas!'"
    ],
    "dev-check": [
      "Composer\\Config::disableProcessTimeout",
      "@fix-all",
      "@test",
      "echo '🎯 Código pronto para desenvolvimento!'"
    ],
    "pre-commit": [
      "Composer\\Config::disableProcessTimeout",
      "pre-commit run --all-files"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit"
    ],
    "test:coverage": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit --coverage-html coverage"
    ],
    "test:unit": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit --testsuite=Unit"
    ],
    "test:integration": [
      "Composer\\Config::disableProcessTimeout",
      "phpunit --testsuite=Integration"
    ],
    "test:all": [
      "@test",
      "@quality"
    ],
    "zip": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/create-release-zip.sh"
    ],
    "marketplace:guards": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/ensure-marketplace-guards.sh"
    ],
    "marketplace:validate": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/validate-marketplace-package.sh"
    ],
    "marketplace:standards": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/validate-marketplace-standards.sh"
    ],
    "marketplace:compatibility": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/validate-marketplace-compatibility.sh"
    ],
    "marketplace:check": [
      "@zip",
      "@marketplace:validate"
    ],
    "marketplace:full-check": [
      "@marketplace:check",
      "@marketplace:standards",
      "@marketplace:compatibility"
    ],
    "prestashop:core": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/fetch-prestashop-core.sh"
    ],
    "pre-release": [
      "Composer\\Config::disableProcessTimeout",
      "./bin/pre-release.sh"
    ],
    "check:local": [
      "Composer\\Config::disableProcessTimeout",
      "bash bin/check-local.sh all"
    ],
    "check:zip": [
      "Composer\\Config::disableProcessTimeout",
      "bash bin/check-local.sh zip"
    ],
    "context:sync": [
      "Composer\\Config::disableProcessTimeout",
      "aoc sync --provider codex"
    ]
  },
  "autoload": {
    "psr-4": {
      "MercadoPago\\": "src/"
    },
    "classmap": [
      "controllers/front/AbstractMercadopagoModuleFrontController.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MercadoPago\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
